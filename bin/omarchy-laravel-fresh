#!/bin/bash
# omarchy-laravel-fresh - Nuclear Laravel reset
# Clears all caches, runs fresh migrations with seeding, and rebuilds assets

set -e

# Check if we're in a Laravel project
if [ ! -f "artisan" ]; then
    echo "Error: Not in a Laravel project directory. artisan file not found."
    exit 1
fi

echo "🚀 Starting nuclear Laravel reset..."

# Clear all caches
echo "🧹 Clearing all caches..."
php artisan cache:clear
php artisan config:clear
php artisan route:clear
php artisan view:clear

# Fresh migrations with seeding
echo "🗄️  Running fresh migrations with seeding..."
php artisan migrate:fresh --seed

# Rebuild assets if package.json exists
if [ -f "package.json" ]; then
    echo "📦 Rebuilding assets..."
    npm run build
else
    echo "⏭️  No package.json found, skipping asset build"
fi

echo "✅ Laravel project reset complete!"
