#!/bin/bash
# Update TablePlus AppImage

set -e

echo "Updating TablePlus..."

# Detect architecture
ARCH=$(uname -m)
if [ "$ARCH" = "x86_64" ]; then
  APPIMAGE_NAME="TablePlus-x64.AppImage"
  DOWNLOAD_URL="https://tableplus.com/release/linux/x64/TablePlus-x64.AppImage"
elif [ "$ARCH" = "aarch64" ]; then
  APPIMAGE_NAME="TablePlus-aarch64.AppImage"
  DOWNLOAD_URL="https://tableplus.com/release/linux/arm64/TablePlus-aarch64.AppImage"
else
  echo "Unsupported architecture: $ARCH"
  exit 1
fi

TEMP_FILE="/tmp/$APPIMAGE_NAME"

echo "Downloading latest TablePlus for $ARCH..."
echo "URL: $DOWNLOAD_URL"

# Download the file
if ! curl -L -o "$TEMP_FILE" "$DOWNLOAD_URL"; then
  echo "❌ Download failed. Opening download page..."
  xdg-open "https://tableplus.com/download/linux?tab=appimage"
  echo ""
  echo "Please download manually, then run: omarchy-update-tableplus"
  exit 1
fi

# Verify it's a valid file (at least 1MB)
FILE_SIZE=$(stat -f%z "$TEMP_FILE" 2>/dev/null || stat -c%s "$TEMP_FILE" 2>/dev/null || echo 0)
if [ "$FILE_SIZE" -lt 1000000 ]; then
  echo "❌ Downloaded file seems invalid (too small)"
  rm -f "$TEMP_FILE"
  exit 1
fi

echo "Download complete! Installing..."

# Backup old version
if [ -f ~/.local/bin/tableplus ]; then
  mv ~/.local/bin/tableplus ~/.local/bin/tableplus.backup
  echo "Backed up old version to ~/.local/bin/tableplus.backup"
fi

# Install new version
mv "$TEMP_FILE" ~/.local/bin/tableplus
chmod +x ~/.local/bin/tableplus

echo "✅ TablePlus updated successfully!"
echo ""
echo "To remove backup: rm ~/.local/bin/tableplus.backup"
