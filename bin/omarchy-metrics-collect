#!/bin/bash
set -euo pipefail

# Collect system metrics to CSV
# Run via cron: * * * * * ~/.local/share/omarchy/bin/omarchy-metrics-collect

METRICS_DIR="$HOME/.local/share/omarchy/metrics"
METRICS_FILE="$METRICS_DIR/system.csv"

mkdir -p "$METRICS_DIR"

# Create header if file doesn't exist
if [[ ! -f "$METRICS_FILE" ]]; then
  echo "timestamp,cpu_temp,cpu_usage,mem_used_pct,disk_used_pct,gpu_usage,gpu_temp" > "$METRICS_FILE"
fi

# Collect metrics
timestamp=$(date +%s)

# CPU temperature (thermal zone 0)
cpu_temp=$(cat /sys/class/thermal/thermal_zone0/temp 2>/dev/null | awk '{print $1/1000}' || echo "0")

# CPU usage (1 second sample)
cpu_usage=$(top -bn1 | grep "Cpu(s)" | awk '{print $2}' | cut -d'%' -f1 || echo "0")

# Memory usage percentage
mem_used_pct=$(free | awk '/Mem:/ {printf "%.1f", $3/$2 * 100}')

# Disk usage percentage (root)
disk_used_pct=$(df / | awk 'NR==2 {print $5}' | tr -d '%')

# GPU metrics (NVIDIA)
if command -v nvidia-smi &>/dev/null; then
  gpu_data=$(nvidia-smi --query-gpu=utilization.gpu,temperature.gpu --format=csv,noheader,nounits 2>/dev/null || echo "0,0")
  gpu_usage=$(echo "$gpu_data" | cut -d',' -f1 | tr -d ' ')
  gpu_temp=$(echo "$gpu_data" | cut -d',' -f2 | tr -d ' ')
else
  gpu_usage="0"
  gpu_temp="0"
fi

# Append to CSV
echo "$timestamp,$cpu_temp,$cpu_usage,$mem_used_pct,$disk_used_pct,$gpu_usage,$gpu_temp" >> "$METRICS_FILE"

# Keep only last 7 days of data (10080 minutes)
tail -n 10081 "$METRICS_FILE" > "$METRICS_FILE.tmp" && mv "$METRICS_FILE.tmp" "$METRICS_FILE"
