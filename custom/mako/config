anchor=top-right
default-timeout=5000
width=420
outer-margin=20
padding=10,15
border-size=2
max-icon-size=32
font=sans-serif 14px

[app-name=Spotify]
invisible=1

[mode=do-not-disturb]
invisible=true

[mode=do-not-disturb app-name=notify-send]
invisible=false

[urgency=low]
background-color=#FAFAFA
text-color=#555555
border-color=#999999

[urgency=normal]
background-color=#FAFAFA
text-color=#222222
border-color=#F45B69

[urgency=critical]
background-color=#F45B69
text-color=#FFFFFF
border-color=#E04A5A
